{
  "name": "@mrgoonie/skillful",
  "version": "0.3.0",
  "type": "module",
  "description": "Per-prompt capability router for coding agents. Routes to exact skills, MCP tools, CLI subcommands, agents and slash commands.",
  "license": "MIT",
  "bin": {
    "skillful": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "skills",
    "mcp",
    "routing",
    "retrieval",
    "claude-code",
    "codex",
    "pi",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkluzek/jev-skillful.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kkluzek/jev-skillful/issues"
  },
  "homepage": "https://github.com/kkluzek/jev-skillful",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.."
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "smol-toml": "1.7.1"
  }
}
