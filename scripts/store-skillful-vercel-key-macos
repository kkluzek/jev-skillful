#!/bin/sh
set -eu

# These defaults intentionally match the typesafe-mcp fork, so one dedicated Vercel
# credential can serve both local launchers without being copied into either client config.
service=${SKILLFUL_VERCEL_KEYCHAIN_SERVICE:-${EVALUATE_VERCEL_KEYCHAIN_SERVICE:-"Vercel AI Gateway - typesafe-mcp"}}
account=${SKILLFUL_VERCEL_KEYCHAIN_ACCOUNT:-${EVALUATE_VERCEL_KEYCHAIN_ACCOUNT:-"typesafe-mcp"}}
security_bin=/usr/bin/security

if [ "$(uname -s)" != "Darwin" ]; then
	echo "This helper requires macOS Keychain." >&2
	exit 1
fi
if [ ! -t 0 ]; then
	echo "Run this helper in an interactive terminal." >&2
	exit 1
fi

restore_echo() {
	stty echo
}
trap restore_echo EXIT HUP INT TERM
printf "Paste the dedicated Vercel AI Gateway key: " >&2
stty -echo
IFS= read -r api_key
stty echo
printf "\n" >&2
trap - EXIT HUP INT TERM

if [ -z "$api_key" ]; then
	echo "No key entered; Keychain was not changed." >&2
	exit 1
fi

# Trust only Apple's signed `security` accessor. Passing the value through stdin keeps it out of
# argv and process listings; `security -w` asks for the value twice when it has no argument.
if ! printf '%s\n%s\n' "$api_key" "$api_key" |
	"$security_bin" add-generic-password -U -a "$account" -s "$service" \
		-T "$security_bin" -w >/dev/null 2>&1; then
	unset api_key
	echo "Could not store the key in macOS Keychain." >&2
	exit 1
fi
unset api_key
echo "Stored the dedicated key and authorized non-interactive access through $security_bin."
