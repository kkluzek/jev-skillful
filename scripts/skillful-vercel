#!/bin/sh
set -eu

service=${SKILLFUL_VERCEL_KEYCHAIN_SERVICE:-${EVALUATE_VERCEL_KEYCHAIN_SERVICE:-"Vercel AI Gateway - typesafe-mcp"}}
account=${SKILLFUL_VERCEL_KEYCHAIN_ACCOUNT:-${EVALUATE_VERCEL_KEYCHAIN_ACCOUNT:-"typesafe-mcp"}}

if [ -n "${SKILLFUL_BINARY:-}" ]; then
	binary=$SKILLFUL_BINARY
elif binary=$(command -v skillful 2>/dev/null); then
	:
else
	echo "skillful-vercel: skillful is not installed or not on PATH" >&2
	exit 1
fi

launcher_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
launcher="$launcher_dir/$(basename "$0")"
if [ "$binary" = "$launcher" ]; then
	echo "skillful-vercel: SKILLFUL_BINARY resolves to the launcher itself" >&2
	exit 1
fi

# `skillful-vercel install` records this absolute launcher in every generated hook.
# Refresh/catalog commands do not need a model credential, so only decision commands read
# Keychain. That keeps asynchronous discovery working even if the key is later removed.
export SKILLFUL_HOOK_LAUNCHER="$launcher"
case ${1:-} in
	hook | remind | route | doctor | eval | export-case)
		if [ "$(uname -s)" != "Darwin" ]; then
			echo "skillful-vercel: macOS Keychain is required" >&2
			exit 1
		fi
		if ! api_key=$(security find-generic-password -a "$account" -s "$service" -w 2>/dev/null); then
			echo "skillful-vercel: Vercel AI Gateway key not found in macOS Keychain" >&2
			echo "skillful-vercel: run scripts/store-skillful-vercel-key-macos" >&2
			exit 1
		fi
		if [ -z "$api_key" ]; then
			echo "skillful-vercel: Vercel AI Gateway key in macOS Keychain is empty" >&2
			exit 1
		fi
		unset TYPESAFE_API_KEY OPENROUTER_API_KEY
		export SKILLFUL_PROVIDER=vercel
		export AI_GATEWAY_API_KEY="$api_key"
		unset api_key
		;;
esac

exec "$binary" "$@"
